{
	admin off
}
{$APP_HOST} {
	tls {$CADDY_TLS:internal}
	request_body {
		max_size 10747904
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
	reverse_proxy app:8000 {
		header_up Host {$APP_HOST}
		header_up -X-Forwarded-Host
		header_up -X-Forwarded-Port
		header_up -X-Forwarded-Prefix
	}
}
