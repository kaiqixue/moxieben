# Copy to .env on the server. No API keys belong in this file or in Git.
COMPOSE_PROJECT_NAME=moxieben-staging
APP_ENV=staging
APP_HOST=staging.example.invalid
APP_IMAGE=moxieben:deploy-implement-01
DATA_PATH=/srv/moxieben/staging/data
SECRETS_PATH=/srv/moxieben/staging/secrets
# Exact, independently verified host(s) returned by the Paddle provider. No wildcards.
PADDLE_RESULT_HOSTS=replace-with-verified-result-host.example.invalid
REGISTRATION_OPEN=0
# Loopback only by default. Use an SSH tunnel for isolated acceptance.
HTTP_BIND=127.0.0.1
HTTPS_BIND=127.0.0.1
# internal for restricted tests; use your certificate contact email for public ACME.
CADDY_TLS=internal
VLM_REVIEW_BASE_URL=
VLM_REVIEW_MODEL=
VLM_REVIEW_AUTO=0
